<?xml version="1.0" encoding="utf-8"?>
<!--
  Release network policy: HTTPS only, system CAs only. No host is exempt,
  LAN addresses included; see "HTTPS on a home network" in the README for
  how to serve branchDAM over TLS on a LAN.

  The sync engine is Go (gomobile) and does its own TLS, so this file is
  the platform layer for any Kotlin-side networking; the engine refuses
  http:// on its own (EngineOptions.DevCleartextHosts is empty in release).

  Debug builds override this file with src/debug/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
